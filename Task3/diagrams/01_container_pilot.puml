@startuml 01_container_pilot
!include <C4/C4_Container>
!include _style.puml

title №1. Приоритизация очереди финмониторинга — Container (пилот: расчёт в облаке на псевдонимизированных данных)

System_Ext(kyc, "KYC-платформа", "Внешний уровень риска клиента")
System_Ext(pub, "Публичные репозитории", "Пакеты Python, базовые образы")

Enterprise_Boundary(bank, "Периметр банка") {
  Person(analyst, "Аналитик финмониторинга", "Разбирает очередь; размечает операции по гайдлайну")
  Person(expert, "Старший эксперт финмониторинга", "Разбирает расхождения разметки; решает о переходе к ограниченному применению")

  System(aml, "Система ПОД/ФТ", "Правила ПВК, пометка операций, очередь и карточка разбора")
  System(dwh, "Хранилище операций (DWH)", "История операций, клиенты, контрагенты")
  System(vault, "Хранилище ключей банка", "Ключ псевдонимизации (HMAC)")
  System(nexus, "Репозиторий артефактов банка", "Зеркало пакетов и образов, SCA-проверка")

  System_Boundary(bus, "Корпоративная шина Kafka") {
    ContainerQueue(t_flags, "flagged-operations", "Kafka topic", "Помеченные операции")
    ContainerQueue(t_prio, "operation-priorities", "Kafka topic", "Приоритеты (пилотный сегмент очереди)")
    ContainerQueue(t_out, "review-outcomes", "Kafka topic", "Итоги разбора и расследований")
  }

  System_Boundary(svc, "Сервис приоритизации — банковская часть") {
    Container(pseudo, "Подготовка и псевдонимизация", "Airflow, Python, Polars", "Ночью: индикаторы типологий по назначению платежа, признаки дробления по точным суммам; токены клиента и контрагента; округление сумм; Parquet")
    Container(gw, "Шлюз обмена с облаком", "Python, S3-клиент", "Выгрузка признаков, загрузка оценок, проверка целостности и схемы")
    Container(apply, "Применение оценок", "Python", "Обратная замена токенов, правила очереди, валидация; теневой режим или пилотный сегмент; baseline по сумме и по правилам")
    ContainerDb(db, "БД сервиса", "PostgreSQL", "Таблица токенов, оценки четырёх вариантов, метки, журнал аудита")
    Container(label, "Сервис разметки", "Web, Python", "Разметка по гайдлайну, двойная разметка контрольной выборки")
    Container(mon, "Мониторинг", "Prometheus, Grafana, Evidently", "Вход, оценки, очередь, бизнес-метрики")
  }
}

Boundary(cloud, "Российское облако (self-hosting, ВМ / Kubernetes)", $tags="cloud") {
  ContainerDb(s3, "Объектное хранилище", "S3, шифрование ключом банка", "Псевдонимизированные признаки, оценки")
  Container(calc, "Расчёт и сравнение моделей", "Python, Polars, igraph, scikit-learn", "Профили и граф по токенам; модель аномалий с графом и без; факторы", $tags="model")
  Container(mlf, "Трекинг экспериментов", "MLflow", "Версии кандидатов и метрики")
}

Rel(kyc, aml, "[ГД-1] Уровень риска клиента", $tags="tb")
Rel(aml, t_flags, "Помеченные операции")
Rel(dwh, pseudo, "[ГД-2] История операций, назначение платежа", $tags="tb")
Rel(t_flags, pseudo, "Читает")
Rel(vault, pseudo, "Ключ HMAC")
Rel(pseudo, db, "Таблица токенов")
Rel(pseudo, gw, "Parquet: токены, округлённые суммы, даты, ОКВЭД, канал, индикаторы типологий, признаки дробления")
Rel(gw, s3, "[ГД-6] Псевдонимизированные признаки, ночью, ГОСТ-VPN", $tags="tb")
Rel(s3, calc, "Признаки")
Rel(calc, s3, "Оценки и факторы по токенам")
Rel(calc, mlf, "Метрики кандидатов")
Rel(s3, gw, "[ГД-7] Оценки и факторы по токенам", $tags="tb")
Rel(gw, apply, "Проверенные оценки")
Rel(apply, db, "Оценки, журнал")
Rel(apply, t_prio, "[ГД-3] Полоса, приоритет, факторы", $tags="tb")
Rel(t_prio, aml, "Порядок пилотного сегмента")
Rel(analyst, aml, "Разбирает очередь")
Rel(aml, t_out, "Итоги разбора")
Rel(t_out, label, "Читает")
Rel(analyst, label, "[ГД-4] Метки по гайдлайну", $tags="tb")
Rel(expert, label, "Разбирает расхождения")
Rel(label, db, "Метки")
Rel(db, mon, "Оценки, метки, итоги")
Rel(pub, nexus, "[ГД-5] Библиотеки и образы", $tags="tb")
Rel(nexus, calc, "Проверенные образы")

SHOW_LEGEND()
@enduml
