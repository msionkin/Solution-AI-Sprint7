@startuml 10_container
!include <C4/C4_Container>
!include _style.puml

title №10. Выявление поддельных документов — Container (целевой прод, on-prem)

System_Ext(gir, "ГИР БО ФНС", "Опубликованная бухгалтерская отчётность юрлиц")

Enterprise_Boundary(bank, "Периметр банка") {
  Person(uw, "Андеррайтер", "Видит флаг и несоответствия; направляет документ на проверку")
  Person(sec, "Служба безопасности", "Проверяет подлинность помеченных документов")

  System(los, "Кредитный конвейер", "Карточка заявки, маршрут проверки, кредитное решение")
  System(ext18, "Сервис извлечения финпоказателей (№18)", "Оригиналы файлов пакета и извлечённые показатели")
  System(dwh, "Хранилище операций (DWH)", "Обороты по счетам клиента в банке")
  ContainerQueue(t_ext, "financials-extracted", "Kafka topic", "Показатели извлечены")

  System_Boundary(svc, "Сервис проверки подлинности документов") {
    Container(orch, "Оркестратор проверок", "Python", "Запуск сверок и модели по документу; идемпотентность по хешу файла")
    Container(forens, "Анализ файла", "Python, изолированная песочница", "Структура и метаданные PDF и изображений, следы редактирования")
    Container(checks, "Детерминированные сверки", "Python", "ГИР БО, обороты по счёту, реквизиты (ИНН, ОГРН), внутренние тождества")
    Container(ratio, "Модель соотношений показателей", "Python, scikit-learn, CPU", "Оценка аномальности соотношений относительно отрасли и масштаба", $tags="model")
    Container(train, "Обучение модели соотношений", "Airflow, Python", "Обучение на открытой БО из ГИР БО; оценка на синтетических подделках", $tags="model")
    Container(flag, "Формирование флага", "Python", "Правила: флаг и перечень несоответствий; отказа не выносит")
    ContainerDb(db, "БД сервиса", "PostgreSQL", "Кэш ГИР БО, результаты проверок, итоги проверок СБ (метки)")
  }
}

Rel(t_ext, orch, "Показатели извлечены")
Rel(ext18, forens, "[Д-1] Оригиналы файлов клиента", $tags="tb")
Rel(orch, forens, "Документ")
Rel(orch, checks, "Показатели")
Rel(orch, ratio, "Показатели")
Rel(gir, db, "[Д-4] Отчётность по ИНН (API, кэш)", $tags="tb")
Rel(db, checks, "Эталон ГИР БО")
Rel(dwh, checks, "Обороты по счетам")
Rel(db, train, "Открытая БО, синтетика")
Rel(train, ratio, "Версия модели")
Rel(forens, flag, "Признаки редактирования")
Rel(checks, flag, "Расхождения")
Rel(ratio, flag, "Оценка аномальности")
Rel(flag, db, "Результаты, журнал")
Rel(flag, los, "[Д-3] Флаг и перечень несоответствий", $tags="tb")
Rel(uw, los, "Видит флаг, направляет на проверку")
Rel(sec, los, "Итог проверки подлинности")
Rel(los, db, "Итоги проверок (метки)")

SHOW_LEGEND()
@enduml
