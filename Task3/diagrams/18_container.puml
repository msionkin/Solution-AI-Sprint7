@startuml 18_container
!include <C4/C4_Container>
!include _style.puml

title №18. Извлечение финансовых показателей — Container (целевой прод, on-prem)

Person_Ext(client, "Клиент (заёмщик)", "Подаёт пакет документов к кредитной заявке")
System_Ext(pub, "Публичные репозитории", "Открытые веса моделей, пакеты Python, образы")

Enterprise_Boundary(bank, "Периметр банка") {
  Person(uw, "Андеррайтер", "Подтверждает или исправляет показатели; вводит эталон по гайдлайну")

  System(los, "Кредитный конвейер", "Заявки, пакеты документов, карточка заявки, кредитное решение")
  System(nexus, "Репозиторий артефактов банка", "Проверенные веса, пакеты и образы")
  ContainerQueue(t_pkg, "credit-package-received", "Kafka topic", "Пакет документов поступил")
  ContainerQueue(t_ext, "financials-extracted", "Kafka topic", "Показатели извлечены (потребитель — №10)")

  System_Boundary(svc, "Сервис извлечения финансовых показателей") {
    Container(intake, "Шлюз приёма документов", "Python, антивирус, CDR", "Проверка и обезвреживание файлов, лимиты размера и страниц, определение формата")
    Container(parser, "Парсер структурированных форматов", "Python", "Excel, выгрузки бухсистем, текстовые PDF-выписки — без модели")
    Container(ctx, "Подготовка контекста", "Python, PaddleOCR", "Тип документа, отбор страниц с нужными формами, OCR-слой для сверки", $tags="model")
    Container(extract, "Оркестратор извлечения", "Python", "Промпт-шаблон + отобранные страницы → запрос с JSON-схемой ответа; инструментов у модели нет")
    Container(llm, "Сервер моделей", "vLLM, 2 GPU", "VLM / LLM с открытыми весами — финалист пилота", $tags="model")
    Container(valid, "Валидатор и проверки", "Python", "Схема ответа, ссылка на источник, сверка с OCR-слоем, единицы и периоды, бухгалтерские тождества, порог уверенности")
    ContainerDb(store, "Хранилище документов и результатов", "S3 on-prem, PostgreSQL", "Файлы, страницы, значения со ссылками, эталон, исправления, журнал")
    Container(mon, "Мониторинг", "Prometheus, Grafana, Evidently", "Вход, качество извлечения, очередь, время андеррайтера")
  }
}

Rel(client, los, "[Д-1] Пакет: PDF, сканы, фото, Excel", $tags="tb")
Rel(los, t_pkg, "Событие о пакете")
Rel(t_pkg, intake, "Читает")
Rel(los, intake, "Файлы пакета")
Rel(intake, store, "Обезвреженные файлы и страницы")
Rel(intake, parser, "Структурированные файлы")
Rel(intake, ctx, "Сканы, фото, PDF")
Rel(ctx, extract, "Отобранные страницы и OCR-слой")
Rel(extract, llm, "Запрос с JSON-схемой")
Rel(extract, valid, "Ответ модели")
Rel(parser, valid, "Значения")
Rel(valid, store, "Значения, флаги, журнал")
Rel(valid, los, "[Д-3] Карточка финпоказателей: значения, ссылки, флаги", $tags="tb")
Rel(valid, t_ext, "Показатели извлечены")
Rel(uw, los, "Проверяет карточку, исправляет")
Rel(los, store, "Исправления андеррайтера (метки)")
Rel(pub, nexus, "[Д-2] Открытые веса и зависимости", $tags="tb")
Rel(nexus, llm, "Проверенные веса и образы")
Rel(valid, mon, "Метрики")

SHOW_LEGEND()
@enduml
