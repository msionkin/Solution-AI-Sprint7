@startuml 01_container_prod
!include <C4/C4_Container>
!include _style.puml

title №1. Приоритизация очереди финмониторинга — Container (целевой прод, on-prem)


System_Ext(kyc, "KYC-платформа", "Внешний уровень риска клиента")
System_Ext(pub, "Публичные репозитории", "Пакеты Python, базовые образы")

Enterprise_Boundary(bank, "Периметр банка") {
  Person(analyst, "Аналитик финмониторинга", "Разбирает очередь и принимает решения по ПВК; размечает операции по гайдлайну")
  Person(expert, "Старший эксперт финмониторинга", "Разбирает расхождения разметки; утверждает версию модели и рабочую точку")
  Person(mle, "ML-инженер", "Сопровождение, мониторинг, переобучение")
  System(aml, "Система ПОД/ФТ", "Правила ПВК, пометка операций, очередь и карточка разбора, фиксация и отчётность")
  System(dwh, "Хранилище операций (DWH)", "История операций, клиенты, контрагенты, справочники")
  System(nexus, "Репозиторий артефактов банка", "Зеркало пакетов и образов, SCA-проверка")

  System_Boundary(bus, "Корпоративная шина Kafka") {
    ContainerQueue(t_flags, "flagged-operations", "Kafka topic", "Помеченные операции")
    ContainerQueue(t_prio, "operation-priorities", "Kafka topic", "Приоритеты операций")
    ContainerQueue(t_out, "review-outcomes", "Kafka topic", "Итоги разбора и расследований")
  }

  System_Boundary(svc, "Сервис приоритизации очереди финмониторинга") {
    Container(feat, "Конвейер признаков", "Airflow, Python, Polars, igraph", "Ночью: профили клиентов, граф контрагентов, текстовые признаки назначения платежа")
    Container(prio, "Сервис приоритизации", "Python", "Микропакет 15 мин и ночной перерасчёт: признаки → модель → нормировка → правила очереди → валидация", $tags="model")
    ContainerDb(db, "БД сервиса", "PostgreSQL", "Признаки, оценки и факторы, метки (три следа раздельно), журнал аудита")
    Container(train, "Конвейер обучения и оценки", "Airflow, Python, scikit-learn, CatBoost", "Обучение, оценка на контрольной выборке, регрессионные прогоны", $tags="model")
    Container(reg, "Реестр моделей", "MLflow", "Версии моделей, метрики, статус утверждения")
    Container(label, "Сервис разметки", "Web, Python", "Разметка по гайдлайну, двойная разметка, разбор расхождений; приём итогов разбора")
    Container(mon, "Мониторинг", "Prometheus, Grafana, Evidently", "Вход, модель, очередь, бизнес-метрики; алерты")
  }
}

Rel(kyc, aml, "[ГД-1] Уровень риска клиента", $tags="tb")
Rel(aml, t_flags, "Помеченные операции")
Rel(t_flags, prio, "Читает")
Rel(dwh, feat, "[ГД-2] История операций, назначение платежа (витрина read-only)", $tags="tb")
Rel(feat, db, "Ночной снимок признаков")
Rel(db, prio, "Признаки")
Rel(prio, db, "Оценки, факторы, журнал")
Rel(reg, prio, "Утверждённая версия модели")
Rel(prio, t_prio, "[ГД-3] Полоса, приоритет, факторы", $tags="tb")
Rel(t_prio, aml, "Порядок очереди")
Rel(analyst, aml, "Разбирает очередь, решения по ПВК")
Rel(aml, t_out, "Эскалации, исходы расследований, подтверждения")
Rel(t_out, label, "Читает")
Rel(analyst, label, "[ГД-4] Метки по гайдлайну", $tags="tb")
Rel(expert, label, "Разбирает расхождения")
Rel(label, db, "Метки")
Rel(db, train, "Признаки, метки, контрольная выборка")
Rel(train, reg, "Кандидат модели и отчёт")
Rel(expert, reg, "Утверждает версию и рабочую точку")
Rel(pub, nexus, "[ГД-5] Библиотеки и образы", $tags="tb")
Rel(nexus, prio, "Проверенные образы (для всех контейнеров)")
Rel(prio, mon, "Метрики")
Rel(db, mon, "Оценки, метки, итоги разбора")
Rel(mon, mle, "Алерты")

SHOW_LEGEND()
@enduml
